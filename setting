            if p and typeof(p) == "Instance" and p.Parent then
                table.insert(savedPinnedNames, tostring(p.DisplayName) .. " (" .. tostring(p.Name) .. ")") 
            end
        end
    end

    local savedAvoidNames = {}
    if _G.HubState.avoidTargets then
        for p, active in pairs(_G.HubState.avoidTargets) do
            if active and p and typeof(p) == "Instance" and p.Parent then
