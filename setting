_G.HubLogic.LoadAllConfig = function(elements)
    if not readfile or not isfile or not isfile("HubAllConfig.json") then 
        warn("[CONFIG LỖI]: Không tìm thấy file lưu cấu hình HubAllConfig.json")
        return 
    end
    
    local success, configData = pcall(function()
        return HttpService:JSONDecode(readfile("HubAllConfig.json"))
    end)
    
    if not success or not configData then return end
    
    elements = elements or {}
    
    if configData.isAutoTpGuiVisible ~= nil then
        _G.HubState.isAutoTpGuiVisible = configData.isAutoTpGuiVisible
        if _G.HubLogic.ToggleAutoTpGui then _G.HubLogic.ToggleAutoTpGui(configData.isAutoTpGuiVisible) end
        if elements.Toggle_AutoTp and elements.Toggle_AutoTp.Set then elements.Toggle_AutoTp:Set(configData.isAutoTpGuiVisible) end
    end

    if configData.isFloatGuiVisible ~= nil then
        _G.HubState.isFloatGuiVisible = configData.isFloatGuiVisible
        if _G.HubLogic.ToggleFloatGui then _G.HubLogic.ToggleFloatGui(configData.isFloatGuiVisible) end
        if elements.Toggle_Float and elements.Toggle_Float.Set then elements.Toggle_Float:Set(configData.isFloatGuiVisible) end
    end

    if configData.BypassM1NoCD ~= nil then
        _G.BypassM1NoCD = configData.BypassM1NoCD
        if _G.HubLogic.TogglePunchBypass then _G.HubLogic.TogglePunchBypass(configData.BypassM1NoCD) end
        if elements.Toggle_Punch and elements.Toggle_Punch.Set then elements.Toggle_Punch:Set(configData.BypassM1NoCD) end
    end

    if configData.isAvoidEnabled ~= nil then
        _G.HubState.isAvoidEnabled = configData.isAvoidEnabled
        if _G.HubLogic.ToggleAvoid then _G.HubLogic.ToggleAvoid(configData.isAvoidEnabled) end
        if elements.Toggle_Avoid and elements.Toggle_Avoid.Set then elements.Toggle_Avoid:Set(configData.isAvoidEnabled) end
    end

    print("[SUCCESS]: Đã nạp thành công toàn bộ cấu hình GUI & Others!")
end
