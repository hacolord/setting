local HttpService = game:GetService("HttpService")

_G.HubState = _G.HubState or {}
_G.HubLogic = _G.HubLogic or {}

-- Hàm lưu toàn bộ cấu hình hệ thống
_G.HubLogic.SaveAllConfig = function()
    local w = _G.HubState.Widgets or {}
    
    local savedPinnedNames = {}
    if _G.HubLogic.HasPinnedPlayers and _G.HubLogic.HasPinnedPlayers() then
        for _, p in ipairs(_G.HubState.pinnedOrder) do 
            table.insert(savedPinnedNames, p.DisplayName .. " (" .. p.Name .. ")") 
        end
    end
    
    local config = {
        -- Main Tab
        speed = _G.HubState._G_speedValue,
        sides = _G.HubState._G_sidesValue, 
        dist = _G.HubState._G_distanceValue,
        height = _G.HubState._G_heightValue,
        fSpeed = _G.HubState._G_flySpeedValue,
        pred = _G.HubState._G_predCoeffValue,
        vel = _G.HubState._G_velCheckValue,
        hModeStr = _G.HubState.currentHeightModeStr, 
        dModeStr = _G.HubState.currentDirModeStr,
        nModeStr = _G.HubState.currentNetModeStr, 
        cModeStr = _G.HubState.currentCombatModeStr,
        tC_Vis = w.classic and w.classic.Visible or false, 
        tN_Vis = w.near and w.near.Visible or false,
        tO_Vis = w.orange and w.orange.Visible or false, 
        tP_Vis = w.purple and w.purple.Visible or false,
        noclip = _G.HubState.isNoclipEnabled,
        visualServer = _G.HubState.isVisualServerEnabled,
        
        -- One Shot Tab
        stud = _G.HubState.studOffset,
        attachDuration = _G.HubState.attachDuration,
        m1 = _G.HubState.mode1Name, 
        m2 = _G.HubState.mode2Name,
        mV = _G.HubState.isMiniVoidVisible, 
        mKB = _G.HubState.isMiniKBVisible,

        -- Kill All Tab
        killAllActive = _G.HubState.killAllActive,
        killAllMiniVis = w.killAll and w.killAll.Visible or false,
        touchFling = _G.HubState.isTouchFlingEnabled,
        antiFling = _G.HubState.isAntiFlingEnabled,
        killAllDelay = _G.HubState.killAll_Delay,
        killAllFirstDead = _G.HubState.killAll_FirstDeadCount,
        killAllLowHealth = _G.HubState.killAll_LowHealthCount,
        killAllDist = _G.HubState.killAll_TeleportDistance,
        killAllDir = _G.HubState.killAll_DirectionMode,

        -- Target List Tab
        pinnedList = savedPinnedNames,

        -- Misc Tab
        espItemsEnabled = _G.HubState.espItemsEnabled,
        tEspItem_Vis = w.espItem and w.espItem.Visible or false,
        espItemsGlow = _G.HubState.espItemsGlow,
        espItemsName = _G.HubState.espItemsName,
        espNpcEnabled = _G.HubState.espNpcEnabled,
        tEspNpc_Vis = w.espNpc and w.espNpc.Visible or false,
        espNpcGlow = _G.HubState.espNpcGlow,
        espNpcName = _G.HubState.espNpcName,

        -- Lưu vị trí (Position) của toàn bộ các Mini GUI
        widgetPositions = {
            classic = w.classic and {w.classic.Position.X.Scale, w.classic.Position.X.Offset, w.classic.Position.Y.Scale, w.classic.Position.Y.Offset},
            near = w.near and {w.near.Position.X.Scale, w.near.Position.X.Offset, w.near.Position.Y.Scale, w.near.Position.Y.Offset},
            orange = w.orange and {w.orange.Position.X.Scale, w.orange.Position.X.Offset, w.orange.Position.Y.Scale, w.orange.Position.Y.Offset},
            purple = w.purple and {w.purple.Position.X.Scale, w.purple.Position.X.Offset, w.purple.Position.Y.Scale, w.purple.Position.Y.Offset},
            killAll = w.killAll and {w.killAll.Position.X.Scale, w.killAll.Position.X.Offset, w.killAll.Position.Y.Scale, w.killAll.Position.Y.Offset},
            void = w.void and {w.void.Position.X.Scale, w.void.Position.X.Offset, w.void.Position.Y.Scale, w.void.Position.Y.Offset},
            kb = w.kb and {w.kb.Position.X.Scale, w.kb.Position.X.Offset, w.kb.Position.Y.Scale, w.kb.Position.Y.Offset},
            espItem = w.espItem and {w.espItem.Position.X.Scale, w.espItem.Position.X.Offset, w.espItem.Position.Y.Scale, w.espItem.Position.Y.Offset},
            espNpc = w.espNpc and {w.espNpc.Position.X.Scale, w.espNpc.Position.X.Offset, w.espNpc.Position.Y.Scale, w.espNpc.Position.Y.Offset}
        }
    }

    if writefile then
        pcall(function() 
            writefile(_G.HubState.fullSaveFileName or "FullGui_Save.json", HttpService:JSONEncode(config)) 
        end)
    end
end

-- Hàm khôi phục toàn bộ cấu hình đã lưu
_G.HubLogic.LoadAllConfig = function(UIElements)
    if not (readfile and isfile) then return end
    
    local fileName = _G.HubState.fullSaveFileName or "FullGui_Save.json"
    local isExist = false
    pcall(function() isExist = isfile(fileName) end)
    
    if isExist then
        local success, parsed = pcall(function() return HttpService:JSONDecode(readfile(fileName)) end)
        if success and type(parsed) == "table" then
            UIElements = UIElements or {}

            -- 1. Tab Main
            if UIElements.Input_Speed then UIElements.Input_Speed:Set(tostring(parsed.speed or 90)) end
            if UIElements.Input_Sides then UIElements.Input_Sides:Set(tostring(parsed.sides or 0)) end 
            if UIElements.Input_Dist then UIElements.Input_Dist:Set(tostring(parsed.dist or 4.5)) end
            if UIElements.Input_Height then UIElements.Input_Height:Set(tostring(parsed.height or 4.5)) end
            if UIElements.Input_Chase then UIElements.Input_Chase:Set(tostring(parsed.fSpeed or 250)) end
            if UIElements.Input_Pred then UIElements.Input_Pred:Set(tostring(parsed.pred or 1)) end
            if UIElements.Input_Vel then UIElements.Input_Vel:Set(tostring(parsed.vel or 2)) end

            if UIElements.Drop_HeightMode then UIElements.Drop_HeightMode:Set({parsed.hModeStr or "MODE: TRÊN TRỜI"}) end
            if UIElements.Drop_DirMode then UIElements.Drop_DirMode:Set({parsed.dModeStr or "ORBIT (XOAY)"}) end
            if UIElements.Drop_NetMode then UIElements.Drop_NetMode:Set({parsed.nModeStr or "NET: NORMAL"}) end
            if UIElements.Drop_CombatMode then UIElements.Drop_CombatMode:Set({parsed.cModeStr or "MODE: OFF (TS/PRED)"}) end

            if UIElements.Toggle_ClassicTracker then UIElements.Toggle_ClassicTracker:Set(parsed.tC_Vis == nil and false or parsed.tC_Vis) end
            if UIElements.Toggle_NearTracker then UIElements.Toggle_NearTracker:Set(parsed.tN_Vis == nil and false or parsed.tN_Vis) end
            if UIElements.Toggle_OrangeFly then UIElements.Toggle_OrangeFly:Set(parsed.tO_Vis == nil and false or parsed.tO_Vis) end
            if UIElements.Toggle_PurpleFly then UIElements.Toggle_PurpleFly:Set(parsed.tP_Vis == nil and false or parsed.tP_Vis) end
            if UIElements.Toggle_Noclip then UIElements.Toggle_Noclip:Set(parsed.noclip == nil and false or parsed.noclip) end
            if UIElements.Toggle_VisualServer then UIElements.Toggle_VisualServer:Set(parsed.visualServer == nil and false or parsed.visualServer) end

            -- 2. Tab One Shot
            if UIElements.InputStudsUI then UIElements.InputStudsUI:Set(tostring(parsed.stud or 0)) end
            if UIElements.InputTimeUI then UIElements.InputTimeUI:Set(tostring(parsed.attachDuration or 0)) end
            if UIElements.DropNgangUI then UIElements.DropNgangUI:Set({parsed.m1 or "Hủy"}) end
            if UIElements.DropTrenUI then UIElements.DropTrenUI:Set({parsed.m2 or "Hủy"}) end
            if UIElements.ToggleVoidUI then UIElements.ToggleVoidUI:Set(parsed.mV == nil and true or parsed.mV) end
            if UIElements.ToggleKBUI then UIElements.ToggleKBUI:Set(parsed.mKB == nil and true or parsed.mKB) end
            
            -- 3. Tab Kill All
            _G.HubState.killAllActive = parsed.killAllActive == nil and false or parsed.killAllActive
            _G.HubState.killAll_TeleportDistance = parsed.killAllDist or 1.5
            _G.HubState.killAll_DirectionMode = parsed.killAllDir or "đằng sau"
            _G.HubState.killAll_Delay = parsed.killAllDelay or 1
            _G.HubState.killAll_FirstDeadCount = parsed.killAllFirstDead or 0
            _G.HubState.killAll_LowHealthCount = parsed.killAllLowHealth or 0
            
            if UIElements.Toggle_TouchFling then UIElements.Toggle_TouchFling:Set(parsed.touchFling == nil and false or parsed.touchFling) end
            if UIElements.Toggle_AntiFling then UIElements.Toggle_AntiFling:Set(parsed.antiFling == nil and false or parsed.antiFling) end
            if UIElements.Input_KillAllDelay then UIElements.Input_KillAllDelay:Set(tostring(parsed.killAllDelay or 1)) end
            if UIElements.Input_KillAllFirstDead then UIElements.Input_KillAllFirstDead:Set(tostring(parsed.killAllFirstDead or 0)) end
            if UIElements.Input_KillAllLowHealth then UIElements.Input_KillAllLowHealth:Set(tostring(parsed.killAllLowHealth or 0)) end
            if UIElements.Input_KillAllDist then UIElements.Input_KillAllDist:Set(tostring(parsed.killAllDist or 1.5)) end
            if UIElements.Drop_KillAllDir then UIElements.Drop_KillAllDir:Set({parsed.killAllDir or "đằng sau"}) end

            local w = _G.HubState.Widgets or {}
            if w.killAll then w.killAll.Visible = parsed.killAllMiniVis == nil and false or parsed.killAllMiniVis end
            if UIElements.Toggle_KillAllMiniVis and w.killAll then UIElements.Toggle_KillAllMiniVis:Set(w.killAll.Visible) end
            
            -- 4. Tab Target List
            if UIElements.PinnedDropdown and parsed.pinnedList then
                UIElements.PinnedDropdown:Set(parsed.pinnedList)
            end

            -- 5. Tab Misc
            if UIElements.Toggle_EspItem then UIElements.Toggle_EspItem:Set(parsed.tEspItem_Vis == nil and false or parsed.tEspItem_Vis) end
            if UIElements.Toggle_EspItemGlow then UIElements.Toggle_EspItemGlow:Set(parsed.espItemsGlow == nil and false or parsed.espItemsGlow) end
            if UIElements.Toggle_EspItemName then UIElements.Toggle_EspItemName:Set(parsed.espItemsName == nil and false or parsed.espItemsName) end
            
            if UIElements.Toggle_EspNpc then UIElements.Toggle_EspNpc:Set(parsed.tEspNpc_Vis == nil and false or parsed.tEspNpc_Vis) end
            if UIElements.Toggle_EspNpcGlow then UIElements.Toggle_EspNpcGlow:Set(parsed.espNpcGlow == nil and false or parsed.espNpcGlow) end
            if UIElements.Toggle_EspNpcName then UIElements.Toggle_EspNpcName:Set(parsed.espNpcName == nil and false or parsed.espNpcName) end

            -- Cập nhật trạng thái logic ESP Item sau khi load
            if _G.HubLogic.SetEspItemsActive then
                _G.HubLogic.SetEspItemsActive(parsed.espItemsEnabled == nil and false or parsed.espItemsEnabled)
            end

            -- Khôi phục vị trí Mini GUI
            if parsed.widgetPositions then
                local wp = parsed.widgetPositions
                if wp.classic and w.classic then w.classic.Position = UDim2.new(wp.classic[1], wp.classic[2], wp.classic[3], wp.classic[4]) end
                if wp.near and w.near then w.near.Position = UDim2.new(wp.near[1], wp.near[2], wp.near[3], wp.near[4]) end
                if wp.orange and w.orange then w.orange.Position = UDim2.new(wp.orange[1], wp.orange[2], wp.orange[3], wp.orange[4]) end
                if wp.purple and w.purple then w.purple.Position = UDim2.new(wp.purple[1], wp.purple[2], wp.purple[3], wp.purple[4]) end
                if wp.killAll and w.killAll then w.killAll.Position = UDim2.new(wp.killAll[1], wp.killAll[2], wp.killAll[3], wp.killAll[4]) end
                if wp.void and w.void then w.void.Position = UDim2.new(wp.void[1], wp.void[2], wp.void[3], wp.void[4]) end
                if wp.kb and w.kb then w.kb.Position = UDim2.new(wp.kb[1], wp.kb[2], wp.kb[3], wp.kb[4]) end
                if wp.espItem and w.espItem then w.espItem.Position = UDim2.new(wp.espItem[1], wp.espItem[2], wp.espItem[3], wp.espItem[4]) end
                if wp.espNpc and w.espNpc then w.espNpc.Position = UDim2.new(wp.espNpc[1], wp.espNpc[2], wp.espNpc[3], wp.espNpc[4]) end
            end

            _G.HubState.isAttached = false
            _G.HubState.targetModeIndex = 3 
            if _G.HubLogic.StopFlying then _G.HubLogic.StopFlying() end
            if _G.HubLogic.UpdateAttachment then _G.HubLogic.UpdateAttachment() end
        end
    end
end
